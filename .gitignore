logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment and sensitive credential files
.env
.env.local
.env.*.local
*.pem
*.key
*.cert
*.id_rsa

# OS and IDE artifacts
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/mcp.json
.idea/
*.swp
*.swo

# Test temporary artifacts
test/temp_*
coverage/
.nyc_output/
